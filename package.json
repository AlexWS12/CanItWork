{
  "name": "tv",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm run dev -w @tv/server\" \"npm run dev -w @tv/web\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p packages/core && tsc --noEmit -p apps/server && tsc --noEmit -p apps/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "eval:interpreter": "npm run eval:interpreter -w @tv/server"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "playwright": "^1.49.1",
    "prettier": "^3.9.10",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
