# Copy to .env. With nothing set, the app runs on local rules and labels every step as such.

# Prune gateway. Vault your Gemini key in the Prune dashboard (Connect > Providers).
PRUNE_API_KEY=
PRUNE_BASE_URL=https://api.withprune.com/v1

# Direct keys: the fallback if Prune is unreachable, or the only route if PRUNE_API_KEY is empty.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Swarms runs the Red Team and the recovery council, billed to one balance.
# Leave the key blank while developing, so day-to-day work spends nothing.
# Swarms refuses runs at $1 or less, and free credits don't count.
# Plain gemini-3.5-flash and xai/grok-4.20-beta crashed on Swarms' side and were still billed.
SWARMS_API_KEY=
SWARMS_MODEL=gemini/gemini-3.5-flash-lite
REDTEAM_MODEL=gemini/gemini-3.5-flash-lite
# Stop spending at this balance and use local rules instead.
SWARMS_KEEP_USD=5

PORT=8787
