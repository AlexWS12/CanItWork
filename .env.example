# Copy to .env. With nothing set, the app runs on local rules and labels every step as such.

# Prune gateway. Vault your Gemini key in the Prune dashboard (Connect > Providers).
PRUNE_API_KEY=
PRUNE_BASE_URL=https://api.withprune.com/v1

# Direct keys: the fallback if Prune is unreachable, or the only route if PRUNE_API_KEY is empty.
GEMINI_API_KEY=
# Free-tier keys allow 15 requests a minute; this paces calls under it. Leave blank on a paid key.
GEMINI_RPM=
GEMINI_MODEL=gemini-3.5-flash-lite
# The Architect designs every environment and falls back to GEMINI_MODEL when this model is busy or out of quota.
# gemini-3.5-flash designs logic circuits better, but the free tier allows it only 20 requests a day.
ARCHITECT_MODEL=gemini-3.5-flash-lite

# TypeSafe's Jev routes requests to a domain, ahead of Gemini. Unsure picks still go to Gemini.
TYPESAFE_API_KEY=

# Swarms runs the Red Team and the recovery council, billed to one balance.
# Leave the key blank while developing, so day-to-day work spends nothing.
# Swarms refuses runs at $1 or less, and free credits don't count.
# Plain gemini-3.5-flash and xai/grok-4.20-beta crashed on Swarms' side and were still billed.
SWARMS_API_KEY=
SWARMS_MODEL=gemini/gemini-3.5-flash-lite
REDTEAM_MODEL=gemini/gemini-3.5-flash-lite
# Stop spending at this balance and use local rules instead.
SWARMS_KEEP_USD=5

PORT=8787

# Design council: three Swarms architects design each request in parallel and the simulator builds the best one.
# Off by default, since every build then costs a Swarms run. Needs SWARMS_API_KEY.
DESIGN_COUNCIL=
DESIGN_COUNCIL_MODEL=
